# Копируйте в .env, затем внесите значения локально. Не отправляйте .env в чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
PLAY_PULSE_FEED_URL=https://play-pulse-news.nemofresh.chatgpt.site/news.json
PLAY_PULSE_AUTH_MODE=sites
PLAY_PULSE_FEED_TOKEN=
# 1: автоматически отправлять владельцам новые записи из существующей ленты.
# При первом включении архив отмечается без рассылки; состояние хранится в .runtime/.
PLAY_PULSE_NOTIFICATIONS_ENABLED=0
PLAY_PULSE_NOTIFICATIONS_INTERVAL_SECONDS=60
# PLAY_PULSE_NOTIFICATIONS_STATE_FILE=.runtime/notifications.json
# Одноразовый импорт checkpoint при переносе; существующий файл не перезаписывается.
# PLAY_PULSE_NOTIFICATIONS_BOOTSTRAP_FILE=/etc/secrets/play-pulse-delivery.json
# PLAY_PULSE_PRESENTATION_URL=https://example.onrender.com/
