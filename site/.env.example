# Use local .env or hosting secrets. Never commit real values.
PORT=10000
# Optional on Render: RENDER_EXTERNAL_URL supplies the canonical origin.
PLAY_PULSE_PUBLIC_ORIGIN=https://your-private-site.onrender.com
PLAY_PULSE_DATA_DIR=/var/data/play-pulse
# Full live archive, provided as a Render Secret File; never use dist/news.json.
PLAY_PULSE_SEED_FILE=/etc/secrets/play-pulse-news.json
# Generate these independently and store only in hosting secrets.
PLAY_PULSE_OWNER_ID=
PP_PASSWORD_PEPPER=
PLAY_PULSE_READ_TOKEN=
PLAY_PULSE_WRITE_TOKEN=
PLAY_PULSE_SETUP_TOKEN=
